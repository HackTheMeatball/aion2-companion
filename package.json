{
  "name": "aion2-companion",
  "version": "0.2.0",
  "private": true,
  "description": "Daeva Companion: unofficial companion for AION 2, currently the Asmodian Assassin leveling guide (single-page web app). Live at https://daevacompanion.com/",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackthemeatball/daeva-companion.git"
  },
  "homepage": "https://daevacompanion.com/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && node tests/run.mjs",
    "test:perf": "npm run build && node tests/run.mjs --only perf",
    "test:quick": "npm run build && node tests/run.mjs --quick --noshots",
    "test:core": "node tests/core.mjs",
    "gen": "node tools/gen/gen.mjs",
    "gen:check": "node tools/gen/gen.mjs && git diff --exit-code -- data/DATA_SOURCES.md",
    "validate": "node tools/gen/validate.mjs",
    "test:data": "node tests/schema.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0"
  }
}
